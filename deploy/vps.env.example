# Paste these into Coolify before the first deploy. Keep the values.
# Generate each secret with: openssl rand -base64 32
# PG_DATABASE_PASSWORD must be hex or letters only. It is embedded in a URL.

PG_DATABASE_PASSWORD=
ENCRYPTION_KEY=

# Optional. Coolify sets SERVICE_URL_SERVER from the domain on server:3000.
# Set SERVER_URL only when you want to override that.
# SERVER_URL=https://crm.example.com

STORAGE_TYPE=local

# Telemetry, social sign-in and email/calendar sync are off in
# docker-compose.yml. AI_PROVIDERS is left unset on purpose (no AI chat).
# After the first login, run once:
#   python3 packages/twenty-apps/internal/hoo-partners/scripts/clean-workspace.py --url https://crm.example.com
